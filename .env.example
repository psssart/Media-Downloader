# Media Downloader Configuration

# File retention period in hours (files are auto-deleted after this time)
MD_FILE_RETENTION_HOURS=24

# How often to run cleanup (in minutes)
MD_CLEANUP_INTERVAL_MINUTES=30

# Maximum concurrent downloads
MD_MAX_CONCURRENT_DOWNLOADS=3

# Debug mode (set to true for development)
MD_DEBUG=false

# --- Video compression (opt-in per download) ---
# Defaults are tuned for 1 vCPU / 3.5 GB RAM / 20 GB disk. See README.
# MD_COMPRESSION_ENABLED=true
# MD_COMPRESSION_CPU_CORES=1
# MD_COMPRESSION_MAX_CONCURRENT_JOBS=          # default: CPU cores
# MD_COMPRESSION_PRESET=veryfast
# MD_COMPRESSION_UPGRADE_PRESET=faster         # used only if it still passes admission
# MD_COMPRESSION_SAFETY_FACTOR=1.75
# MD_COMPRESSION_MAX_TOTAL_WAIT_SEC=1800
# MD_COMPRESSION_MAX_QUEUE_LENGTH=5
# MD_COMPRESSION_MAX_JOBS_PER_USER=1
# MD_COMPRESSION_MAX_JOBS_PER_IP=2
# MD_COMPRESSION_MAX_INPUT_DURATION_SEC=1200
# MD_COMPRESSION_MAX_INPUT_HEIGHT=1080
# MD_COMPRESSION_MAX_INPUT_FILE_MB=1500
# MD_COMPRESSION_THROUGHPUT_OVERRIDE=          # px/s; disables calibration
# MD_COMPRESSION_TWO_PASS_FACTOR=1.6
# MD_COMPRESSION_MIN_FREE_DISK_MB=2048
# MD_COMPRESSION_MIN_FREE_RAM_MB=768
